# cdata Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API Keys
# =============================================================================

# Alpha Vantage - Stock market data (https://www.alphavantage.co/support/#api-key)
ALPHAVANTAGE_API_KEY=

# NewsAPI - News aggregation (https://newsapi.org/register)
NEWSAPI_KEY=

# =============================================================================
# Paths (Optional - defaults shown)
# =============================================================================

# Configuration directory
# CDATA_CONFIG_DIR=./config

# Data storage directory
# CDATA_DATA_DIR=./data

# Log directory
# CDATA_LOG_DIR=./logs

# =============================================================================
# Scheduler Settings (Optional)
# =============================================================================

# Scheduler database URL (default: SQLite in data dir)
# CDATA_SCHEDULER_DB=sqlite:///./data/scheduler.db

# =============================================================================
# Logging (Optional)
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
# CDATA_LOG_LEVEL=INFO
